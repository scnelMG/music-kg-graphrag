{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-answer-schema/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "question_class", "answer", "claims", "refusal_reason", "metadata"],
  "properties": {
    "status": {"enum": ["ANSWERED", "UNCERTAIN", "REFUSED"]},
    "question_class": {"type": "string"},
    "answer": {"type": "string"},
    "refusal_reason": {"type": ["string", "null"]},
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "candidate_id", "evidence_ids", "uncertainty"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string"},
          "candidate_id": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "uncertainty": {"type": "boolean"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt", "output_schema", "provider_config", "retrieval_policy", "graph_snapshot"],
      "properties": {
        "system_prompt": {"const": "evidence-bound-system-prompt/1.0.0"},
        "output_schema": {"const": "graph-answer-schema/1.0.0"},
        "provider_config": {"const": "fixture-json-provider/1.0.0:model=deterministic:no-tools"},
        "retrieval_policy": {"const": "typed-allowlist-prune/1.0.0"},
        "graph_snapshot": {"const": "https://w3id.org/music-kg-graphrag/graph/musicbrainz/generation/fixture-20260731"}
      }
    }
  }
}
