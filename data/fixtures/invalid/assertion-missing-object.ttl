@prefix music: <https://w3id.org/music-kg-graphrag/ontology#> .
@prefix assertion: <https://w3id.org/music-kg-graphrag/resource/assertion/> .
@prefix entity: <https://w3id.org/music-kg-graphrag/resource/entity/> .
@prefix fixturegraph: <https://w3id.org/music-kg-graphrag/graph/fixture/> .
@prefix run: <https://w3id.org/music-kg-graphrag/resource/run/> .
@prefix source: <https://w3id.org/music-kg-graphrag/resource/source/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

source:missing-object a music:Source ;
    music:stableId "source:missing-object" .
run:missing-object a music:RetrievalRun .
fixturegraph:missing-object a music:NamedGraph .

assertion:missing-object a music:Assertion ;
    music:stableId "assertion:missing-object" ;
    music:source source:missing-object ;
    music:assertedSubject entity:subject ;
    music:assertedPredicate music:hasGenre ;
    music:confidence "0.8"^^xsd:decimal ;
    music:retrievalRun run:missing-object ;
    music:namedGraph fixturegraph:missing-object .
