@prefix music: <https://w3id.org/music-kg-graphrag/ontology#> .
@prefix artist: <https://w3id.org/music-kg-graphrag/resource/artist/> .
@prefix recommendation: <https://w3id.org/music-kg-graphrag/resource/recommendation/> .
@prefix releasegroup: <https://w3id.org/music-kg-graphrag/resource/release-group/> .
@prefix review: <https://w3id.org/music-kg-graphrag/resource/review/> .
@prefix track: <https://w3id.org/music-kg-graphrag/resource/track/> .

artist:example a music:Artist ;
    music:title "Example Artist" .

releasegroup:incomplete a music:ReleaseGroup ;
    music:title "Incomplete Album" .

track:incomplete a music:Track .

review:incomplete a music:UserReview ;
    music:ratingLabel "five stars" .

recommendation:incomplete a music:Recommendation ;
    music:targetReleaseGroup releasegroup:incomplete .
