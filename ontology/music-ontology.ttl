@prefix music: <https://w3id.org/music-kg-graphrag/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

music: a owl:Ontology ;
    dcterms:title "Music KG GraphRAG Ontology" ;
    dcterms:description "Small ontology for source-aware music records and evidence-backed recommendations." ;
    owl:versionInfo "0.2.0" .

music:User a owl:Class ;
    rdfs:label "User" .

music:Artist a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:subClassOf prov:Agent .

music:Album a owl:Class ;
    rdfs:label "Album" ;
    rdfs:comment "Deprecated compatibility superclass; new data uses ReleaseGroup or Release." ;
    owl:deprecated true .

music:ReleaseGroup a owl:Class ;
    rdfs:label "Release group" ;
    rdfs:comment "The abstract musical product shared by specific editions." ;
    rdfs:subClassOf music:Album .

music:Release a owl:Class ;
    rdfs:label "Release" ;
    rdfs:comment "A specific published edition belonging to one release group." ;
    rdfs:subClassOf music:Album .

music:Track a owl:Class ;
    rdfs:label "Track" .

music:Genre a owl:Class ;
    rdfs:label "Genre" ;
    rdfs:subClassOf skos:Concept .

music:Mood a owl:Class ;
    rdfs:label "Mood" ;
    rdfs:subClassOf skos:Concept .

music:ListeningContext a owl:Class ;
    rdfs:label "Listening context" .

music:UserReview a owl:Class ;
    rdfs:label "User review" .

music:Recommendation a owl:Class ;
    rdfs:label "Recommendation" .

music:RecommendationEvidence a owl:Class ;
    rdfs:label "Recommendation evidence" ;
    rdfs:comment "A stable evidence item with a graph path and supporting assertions." ;
    rdfs:subClassOf prov:Entity .

music:Source a owl:Class ;
    rdfs:label "Source" ;
    rdfs:subClassOf prov:Entity .

music:Assertion a owl:Class ;
    rdfs:label "Source-qualified assertion" ;
    rdfs:comment "An explicit resource for one source-qualified claim; RDF-star is not used." ;
    rdfs:subClassOf prov:Entity .

music:RetrievalRun a owl:Class ;
    rdfs:label "Retrieval run" ;
    rdfs:subClassOf prov:Activity .

music:NamedGraph a owl:Class ;
    rdfs:label "Named graph" ;
    rdfs:subClassOf prov:Entity .

music:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string .

music:createdBy a owl:ObjectProperty ;
    rdfs:label "created by" ;
    rdfs:range music:Artist .

music:containsRelease a owl:ObjectProperty ;
    rdfs:label "contains release" ;
    rdfs:domain music:ReleaseGroup ;
    rdfs:range music:Release ;
    owl:inverseOf music:releaseOf .

music:releaseOf a owl:ObjectProperty ;
    rdfs:label "release of" ;
    rdfs:domain music:Release ;
    rdfs:range music:ReleaseGroup .

music:containsTrack a owl:ObjectProperty ;
    rdfs:label "contains track" ;
    rdfs:domain music:Release ;
    rdfs:range music:Track .

music:hasGenre a owl:ObjectProperty ;
    rdfs:label "has genre" ;
    rdfs:range music:Genre .

music:hasMood a owl:ObjectProperty ;
    rdfs:label "has mood" ;
    rdfs:range music:Mood .

music:hasListeningContext a owl:ObjectProperty ;
    rdfs:label "has listening context" ;
    rdfs:domain music:UserReview ;
    rdfs:range music:ListeningContext .

music:wroteReview a owl:ObjectProperty ;
    rdfs:label "wrote review" ;
    rdfs:domain music:User ;
    rdfs:range music:UserReview .

music:targetAlbum a owl:ObjectProperty ;
    rdfs:label "target album" ;
    rdfs:comment "Compatibility property for clients that still address the Album superclass." ;
    rdfs:range music:Album .

music:targetReleaseGroup a owl:ObjectProperty ;
    rdfs:label "target release group" ;
    rdfs:range music:ReleaseGroup ;
    rdfs:subPropertyOf music:targetAlbum .

music:favoriteTrack a owl:ObjectProperty ;
    rdfs:label "favorite track" ;
    rdfs:range music:Track .

music:similarTo a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "similar to" .

music:hasReason a owl:DatatypeProperty ;
    rdfs:label "has reason" ;
    rdfs:range xsd:string .

music:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    rdfs:domain music:Recommendation ;
    rdfs:range music:RecommendationEvidence .

music:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by" ;
    rdfs:domain music:RecommendationEvidence ;
    rdfs:range music:Assertion ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

music:evidencePath a owl:DatatypeProperty ;
    rdfs:label "evidence path" ;
    rdfs:domain music:RecommendationEvidence ;
    rdfs:range xsd:string .

music:ratingLabel a owl:DatatypeProperty ;
    rdfs:label "rating label" ;
    rdfs:domain music:UserReview ;
    rdfs:range xsd:string .

music:ratingValue a owl:DatatypeProperty ;
    rdfs:label "rating value" ;
    rdfs:domain music:UserReview ;
    rdfs:range xsd:decimal .

music:externalId a owl:DatatypeProperty ;
    rdfs:label "external identifier" ;
    rdfs:range xsd:string .

music:stableId a owl:DatatypeProperty ;
    rdfs:label "stable identifier" ;
    rdfs:range xsd:string .

music:source a owl:ObjectProperty ;
    rdfs:label "source" ;
    rdfs:domain music:Assertion ;
    rdfs:range music:Source ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

music:assertedSubject a owl:ObjectProperty ;
    rdfs:label "asserted subject" ;
    rdfs:domain music:Assertion ;
    rdfs:range rdfs:Resource .

music:assertedPredicate a owl:ObjectProperty ;
    rdfs:label "asserted predicate" ;
    rdfs:domain music:Assertion ;
    rdfs:range rdf:Property .

music:assertedObject a rdf:Property ;
    rdfs:label "asserted object" ;
    rdfs:domain music:Assertion .

music:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain music:Assertion ;
    rdfs:range xsd:decimal .

music:retrievalRun a owl:ObjectProperty ;
    rdfs:label "retrieval run" ;
    rdfs:domain music:Assertion ;
    rdfs:range music:RetrievalRun ;
    rdfs:subPropertyOf prov:wasGeneratedBy .

music:namedGraph a owl:ObjectProperty ;
    rdfs:label "named graph" ;
    rdfs:domain music:Assertion ;
    rdfs:range music:NamedGraph ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

music:sourceName a owl:DatatypeProperty ;
    rdfs:label "source name" ;
    rdfs:domain music:Source ;
    rdfs:range xsd:string .
