# Copy this file to .env and replace placeholders. Do not commit real secrets.

# Notion source of truth. Create an Internal Integration, share the data source with it, and keep this token server-only.
NOTION_API_KEY=replace-with-notion-integration-token
NOTION_DATA_SOURCE_ID=replace-with-notion-data-source-id
NOTION_ALBUM_TITLE_FIELD=앨범명
NOTION_ARTIST_FIELD=가수
NOTION_COVER_FIELD=앨범커버
NOTION_SENTIMENT_FIELD=개인 감상평
NOTION_FAVOURITE_TRACK_FIELD=개인 최애곡
NOTION_OWNED_FIELD=앨범 보유
NOTION_RELEASE_GROUP_MBID_FIELD=MusicBrainz MBID
# Connected mode refuses placeholder values and never silently falls back to fixture data.
MUSIC_KG_CONNECTED_MODE=connected
# The personal recommendation path requires a private GraphDB repository. Keep it on
# loopback locally or a private VPC address in Cloud Run; never expose this endpoint to browsers.
MUSIC_KG_GRAPHDB_BASE_URL=http://127.0.0.1:7200
MUSIC_KG_GRAPHDB_REPOSITORY=music-kg-personal
# MusicBrainz requires a meaningful, contactable User-Agent and <= 1 request/second.
MUSICBRAINZ_USER_AGENT=music-kg-graphrag/0.1.0 (replace-with-email-or-url)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_REQUESTS_PER_SECOND=1
COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org

# PostgreSQL with pgvector.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=music_kg
POSTGRES_USER=music_kg
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql://music_kg:replace-with-local-postgres-password@localhost:5432/music_kg

# Ontotext GraphDB.
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_PORT=7200
GRAPHDB_REPOSITORY=music-kg
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_HEAP_SIZE=2g

# Optional grounded explanation. Disabled by default: recommendation rank and evidence do not depend on it.
# Set these only in a server-side secret store. Never expose them through NEXT_PUBLIC_* variables.
MUSIC_KG_LLM_ENABLED=false
MUSIC_KG_LLM_BASE_URL=https://api.openai.com/v1
MUSIC_KG_LLM_MODEL=
MUSIC_KG_LLM_API_KEY=

# Optional enrichment sources for later todos.
LASTFM_API_KEY=
WIKIDATA_USER_AGENT=music-kg-graphrag/0.1.0 (replace-with-email-or-url)
