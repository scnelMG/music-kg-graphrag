# Never prefix backend configuration with NEXT_PUBLIC_.
# Next.js server routes use these values; browser bundles must not receive them.
BACKEND_BASE_URL=https://fixture-api.example.invalid
BACKEND_BFF_SHARED_SECRET=replace-with-server-only-preview-secret

# Optional but required for a public deployment that contains one listener's private Notion history.
# These are server-only Vercel variables. Never use NEXT_PUBLIC_ for any of them.
MUSIC_KG_OWNER_SESSION_REQUIRED=false
MUSIC_KG_OWNER_SETUP_TOKEN=replace-with-a-random-32-byte-owner-setup-token
MUSIC_KG_OWNER_SESSION_SECRET=replace-with-a-distinct-random-32-byte-session-secret

# Public values must be demonstrably non-secret.
NEXT_PUBLIC_DEMO_MODE=fixture
