# Dedicated Notion data source only. Never copy production IDs into this file.
NOTION_API_KEY=replace-with-notion-integration-token
NOTION_DATA_SOURCE_ID=replace-with-dedicated-e2e-notion-data-source-id
NOTION_PRODUCTION_DATA_SOURCE_ID=replace-with-production-notion-data-source-id
BACKEND_BFF_SHARED_SECRET=replace-with-connected-e2e-service-bff-secret

# The deployed E2E Cloud Run service must use the same dedicated NOTION_DATA_SOURCE_ID.
MUSIC_KG_CONNECTED_MODE=connected
