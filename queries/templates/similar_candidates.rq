PREFIX music: <https://w3id.org/music-kg-graphrag/ontology#>
SELECT ?candidate ?shared
WHERE {
  GRAPH ?snapshot {
    ?originAssertion music:assertedSubject ?origin ;
                     music:assertedPredicate ?relation ;
                     music:assertedObject ?shared ;
                     music:source ?source .
    ?candidateAssertion music:assertedSubject ?candidate ;
                        music:assertedPredicate ?relation ;
                        music:assertedObject ?shared ;
                        music:source ?source .
    FILTER (?candidate != ?origin)
  }
}
LIMIT 100
